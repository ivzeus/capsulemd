{
  "name": "capsulemd",
  "version": "1.0.0",
  "description": "capsule Media Downloader — a containerized web app for downloading videos/playlists via yt-dlp",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "docker compose build --no-cache",
    "docker-run": "docker compose up --build"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "cors": "^2.8.5"
  }
}
